# Copier en .env sur le serveur et adapter.
# DOMAIN est obligatoire en production ; les autres lignes sont optionnelles.

# Domaine public du site
DOMAIN=tyrajosaure.example.com

# Nom du réseau Docker partagé avec nginx-proxy (voir : docker network ls)
PROXY_NETWORK=nginx-proxy

# Port local utilisé par docker-compose.local.yml
LOCAL_PORT=8000
